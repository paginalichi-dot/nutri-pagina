# Desarrollo: copiá este archivo a .env.local
LOCAL_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5435/nutricion_db

# Producción: van en .env.prod (local) o en las variables de Vercel, con APP_ENV=production
APP_ENV=
# Pooler de Supabase (Transaction, puerto 6543). La usa la app.
DATABASE_URL=
# Conexión directa de Supabase (puerto 5432). La usan las migraciones.
DIRECT_URL=

# Supabase Auth (panel admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo en el servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
