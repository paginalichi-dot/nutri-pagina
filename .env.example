# Desarrollo: copiá este archivo a .env.local
LOCAL_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5435/nutricion_db

# Producción: van en .env.prod (local) o en las variables de Vercel, con APP_ENV=production
APP_ENV=
# Pooler de Supabase (Transaction, puerto 6543). La usa la app.
DATABASE_URL=
# Conexión directa de Supabase (puerto 5432). La usan las migraciones.
DIRECT_URL=

# Login del panel (ADR 0004). Firma las sesiones: sólo en el servidor, nunca con prefijo NEXT_PUBLIC_.
# Va en .env.local, .env.prod y Vercel, con un valor distinto en cada uno. Para generarlo:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Emails de turnos (T-5): Resend. Sólo en el servidor. Sin clave, los emails no se mandan y el panel avisa
# "No pudimos mandar el email". Sin dominio verificado, Resend sólo entrega a la casilla dueña de la cuenta.
RESEND_API_KEY=
# Remitente. Vacío usa el de prueba de Resend: Lisandro López <onboarding@resend.dev>
EMAIL_FROM=

# Cuentas de pacientes (ADR 0006): dirección pública del sitio, para los links de los emails (activar la cuenta,
# restablecer la contraseña, confirmar un email nuevo). Vacía, en local usa http://localhost:3000; en producción es obligatoria.
APP_URL=
# Sólo tests E2E: carpeta donde se guardan los emails en vez de mandarlos. Prohibida en producción.
EMAIL_OUTBOX_DIR=

# Reserva online (Sprint 4, ADR 0007). WhatsApp de Lisandro para «Escribile a Lisandro» cuando faltan menos de 24 h
# (con código de área, por ejemplo 11 2345-6789). Vacío: se muestra el texto sin link.
LISANDRO_WHATSAPP=
# Secreto del cron que vence las solicitudes sin confirmar (GET /api/cron/expire-pending con
# "Authorization: Bearer <secreto>"). Sólo en el servidor y en Vercel (Sprint 5). Vacío: el endpoint siempre da 401.
CRON_SECRET=
