generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(254)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  sessionVersion Int       @default(1) @map("session_version")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_user")
}

enum LocationKind {
  IN_PERSON
  ONLINE
}

model Location {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(60)
  kind         LocationKind
  address      String?       @db.VarChar(120)
  directions   String?       @db.VarChar(200)
  mapUrl       String?       @map("map_url") @db.VarChar(1000)
  videoUrl     String?       @map("video_url") @db.VarChar(500)
  active       Boolean       @default(true)
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  hours        WeeklyHours[]
  appointments Appointment[]

  @@map("location")
}

model WeeklyHours {
  id          String   @id @default(uuid()) @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  location    Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([locationId])
  @@map("weekly_hours")
}

model AgendaSettings {
  id          Int      @id @default(1)
  slotMinutes Int      @map("slot_minutes")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("agenda_settings")
}

model HealthInsurance {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(60)
  active       Boolean       @default(true)
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  appointments Appointment[]

  @@map("health_insurance")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum AppointmentSource {
  ONLINE
  PANEL
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  locationId        String            @map("location_id") @db.Uuid
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  startsAt          DateTime          @map("starts_at") @db.Timestamptz
  endsAt            DateTime          @map("ends_at") @db.Timestamptz
  status            AppointmentStatus
  source            AppointmentSource
  patientName       String            @map("patient_name") @db.VarChar(80)
  patientPhone      String            @map("patient_phone") @db.VarChar(20)
  patientEmail      String?           @map("patient_email") @db.VarChar(254)
  healthInsuranceId String?           @map("health_insurance_id") @db.Uuid
  healthInsurance   HealthInsurance?  @relation(fields: [healthInsuranceId], references: [id], onDelete: Restrict)
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@index([startsAt])
  @@index([patientEmail])
  @@map("appointment")
}

model TimeBlock {
  id        String   @id @default(uuid()) @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  reason    String?  @db.VarChar(100)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([startsAt])
  @@map("time_block")
}

enum PatientTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

model Patient {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(80)
  email           String         @unique @db.VarChar(254)
  phone           String         @db.VarChar(20)
  passwordHash    String         @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz
  consentAt       DateTime       @map("consent_at") @db.Timestamptz
  sessionVersion  Int            @default(1) @map("session_version")
  failedAttempts  Int            @default(0) @map("failed_attempts")
  lockedUntil     DateTime?      @map("locked_until") @db.Timestamptz
  version         Int            @default(1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  tokens          PatientToken[]

  @@map("patient")
}

model PatientToken {
  id        String              @id @default(uuid()) @db.Uuid
  patientId String              @map("patient_id") @db.Uuid
  patient   Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose   PatientTokenPurpose
  tokenHash String              @unique @map("token_hash") @db.Char(64)
  newEmail  String?             @map("new_email") @db.VarChar(254)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz
  usedAt    DateTime?           @map("used_at") @db.Timestamptz
  version   Int                 @default(1)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@index([patientId, purpose])
  @@map("patient_token")
}

model RateLimit {
  key       String   @id @db.VarChar(200)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("rate_limit")
}
